# Lambda / Gemma
GEMMA_BASE_URL=http://localhost:8000/v1
GEMMA_API_KEY=
GEMMA_MODEL=google/gemma-2-9b-it

# Gateway
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
VERDICT_TOKEN_SECRET=change-me

# Nango
# Leave the connection IDs blank to serve fixtures/catalog.json instead.
NANGO_SECRET_KEY=
NANGO_HOST=https://api.nango.dev
NANGO_DRIVE_PROVIDER_KEY=google-drive
NANGO_DRIVE_CONNECTION_ID=
NANGO_OKTA_PROVIDER_KEY=okta
NANGO_OKTA_CONNECTION_ID=
NANGO_OKTA_USER_ID=me
CATALOG_TTL_MS=60000

# Respan
RESPAN_API_KEY=

# Email HITL (pick one)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=

# Optional Resend fallback
# RESEND_API_KEY=

# Injection screener thresholds (0–1)
INJECTION_BLOCK_THRESHOLD=0.75
INJECTION_ESCALATE_THRESHOLD=0.4
