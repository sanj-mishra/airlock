# Lambda / Gemma (gateway talks to vLLM through the SSH tunnel)
GEMMA_BASE_URL=http://localhost:8000/v1
GEMMA_MODEL=google/gemma-2-9b-it
# Optional — only if you enable auth on the vLLM server (default: leave blank)
# GEMMA_API_KEY=

# Hugging Face — needed on the Lambda box to download gated Gemma weights
# https://huggingface.co/settings/tokens  (Read) + accept license on the model page
HF_TOKEN=

# Gateway
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
VERDICT_TOKEN_SECRET=change-me-to-a-long-random-string

# Nango
# Leave the connection IDs blank to serve fixtures/catalog.json instead.
NANGO_SECRET_KEY=
NANGO_DRIVE_PROVIDER_KEY=google-drive
NANGO_DRIVE_CONNECTION_ID=
CATALOG_TTL_MS=60000

# Respan
RESPAN_API_KEY=
RESPAN_APP_NAME=airlock
# Screened content is untrusted and often confidential. Set to 1 only if you
# want the payloads themselves in Respan traces (useful for dataset curation).
RESPAN_TRACE_CONTENT=0
# debug|info|warn|error — warn keeps the demo terminal clean.
RESPAN_LOG_LEVEL=warn

# Email HITL — Gmail SMTP (App Password, not your Google login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=

# Injection screener thresholds (0–1)
INJECTION_BLOCK_THRESHOLD=0.75
INJECTION_ESCALATE_THRESHOLD=0.4
# Max chars of content sent to the screener. Must leave room inside vLLM's
# --max-model-len (2048) for the instructions (~400 tok) and response (200 tok).
INJECTION_MAX_CHARS=3500

# Hooks
# Hooks fail CLOSED when the gateway is unreachable. Uncomment during setup only.
# AIRLOCK_FAIL_OPEN=1
# How long a hook holds an escalated action before failing closed (ms).
AIRLOCK_ESCALATION_TIMEOUT_MS=60000
# How long an escalation stays resolvable from the email link (ms).
ESCALATION_TTL_MS=600000

# Egress classifier thresholds (0–1) + ACL against catalog ownerGroups
EGRESS_BLOCK_THRESHOLD=0.7
EGRESS_ESCALATE_THRESHOLD=0.4
EGRESS_MAX_CHARS=2500
